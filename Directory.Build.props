<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 10 version 2004 and later. Earlier builds lack capture exclusion and parts of window capture. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- x64 is the supported and released architecture. -p:WinScreenArchitecture=arm64 still compiles, as a check only. -->
    <WinScreenArchitecture Condition="'$(WinScreenArchitecture)' == ''">x64</WinScreenArchitecture>
    <Platforms>$(WinScreenArchitecture)</Platforms>
    <PlatformTarget>$(WinScreenArchitecture)</PlatformTarget>
    <RuntimeIdentifier>win-$(WinScreenArchitecture)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>WinScreen</Company>
    <Product>WinScreen</Product>
    <Copyright>Copyright (c) 2026 WinScreen</Copyright>
    <!-- The published version line. Local betas add a number (0.8.0-beta.4); see build.ps1 -Beta. -->
    <Version>1.0.0</Version>
    <!-- local: built on a developer's PC; release: built from a version tag by the Release workflow (build.ps1 -Release). -->
    <WinScreenReleaseType Condition="'$(WinScreenReleaseType)' == ''">local</WinScreenReleaseType>
    <!-- Keep the commit out of the product version, so every signed file reports the same version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- What the projects under src build goes to artifacts\bin\<project> and artifacts\obj\<project> at the root,
       not beside their sources. The tests keep their own bin folders: the portable test apps live there. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src\', StringComparison.OrdinalIgnoreCase))">
    <WinScreenArtifacts>$(MSBuildThisFileDirectory)artifacts\</WinScreenArtifacts>
    <BaseOutputPath>$(WinScreenArtifacts)bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(WinScreenArtifacts)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
