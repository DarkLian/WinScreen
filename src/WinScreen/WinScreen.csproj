<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">DarkLian/WinScreen</UpdateRepository>
    <AssemblyName>WinScreen</AssemblyName>
    <RootNamespace>WinScreen</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinScreen.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The languages WinScreen is translated into. The rest of .NET's translations would never be seen. -->
    <SatelliteResourceLanguages>en;zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <!-- File description: a local build says so; a published one is just WinScreen. -->
    <AssemblyTitle Condition="'$(WinScreenReleaseType)' == 'local'">WinScreen (local build)</AssemblyTitle>
  </PropertyGroup>
  <Target Name="BuildHoverHelper" BeforeTargets="PrepareForBuild" Condition="'$(WinScreenArchitecture)' == 'x64'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../WinScreen.Hover/build.ps1&quot; -Output &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'hover', 'WinScreen.Hover.dll'))&quot;" />
    <Delete Files="$(TargetDir)WinScreen.Hover.dll" Condition="!Exists('$(IntermediateOutputPath)hover/WinScreen.Hover.dll')" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)hover/WinScreen.Hover.dll" Link="WinScreen.Hover.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(IntermediateOutputPath)hover/WinScreen.Hover.dll')" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
    <AssemblyMetadata Include="ReleaseType" Value="$(WinScreenReleaseType)" />
    <EmbeddedResource Include="Updates\update-public-key.pem" LogicalName="WinScreen.UpdatePublicKey" Condition="Exists('Updates\update-public-key.pem')" />
    <EmbeddedResource Include="Localization\*.json" WithCulture="false" LogicalName="WinScreen.Localization.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="WinScreen.Tests" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>
  <!-- Visual Studio designer support and a debugger helper: installed apps use neither. -->
  <Target Name="DropUnusedRuntimeFiles" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="'%(Filename)' == 'System.Windows.Forms.Design' Or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64' Or '%(Filename)' == 'Microsoft.DiaSymReader.Native.arm64'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'System.Windows.Forms.Design' Or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64' Or '%(Filename)' == 'Microsoft.DiaSymReader.Native.arm64'" />
    </ItemGroup>
  </Target>
</Project>
