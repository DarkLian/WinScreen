<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WinScreen.Tests</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WinScreen\WinScreen.csproj" />
    <ProjectReference Include="..\WinScreen.TestTarget\WinScreen.TestTarget.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Validate the exact sources built with this test assembly, including on packaged test runs. -->
    <EmbeddedResource Include="..\..\src\WinScreen\**\*.cs"
                      WithCulture="false" LogicalName="LocalizationSource.%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- settings.json as each published version saved it (tools\settings-fixtures). -->
    <EmbeddedResource Include="Fixtures\settings\*.json" WithCulture="false" LogicalName="SettingsFixture.%(Filename)%(Extension)" />
    <!-- The compatibility page, whose app table must match the app profiles (AppProfileTests). -->
    <EmbeddedResource Include="..\..\docs\FEATURE_COMPATIBILITY.md" WithCulture="false" LogicalName="Doc.FEATURE_COMPATIBILITY.md" />
  </ItemGroup>
</Project>
